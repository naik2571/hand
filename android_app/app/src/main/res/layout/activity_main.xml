<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AirTouch"
                android:textColor="#38BDF8"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Touchless Front-Camera Gesture Control"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:layout_marginBottom="16dp" />

            <!-- Camera Preview with Live Tracking -->
            <androidx.camera.view.PreviewView
                android:id="@+id/camera_preview"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:background="#1E293B"
                android:layout_marginBottom="12dp" />

            <!-- Live Status Card -->
            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Initializing Camera &amp; AI..."
                android:textColor="#FACC15"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="10dp"
                android:background="#1E293B"
                android:layout_marginBottom="14dp" />

            <!-- Interactive Test Target Button -->
            <Button
                android:id="@+id/btn_test_target"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="AIR-TAP HERE TO TEST (Tapped: 0)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#8B5CF6"
                android:layout_marginBottom="16dp" />

            <!-- 3 Permission Steps -->
            <Button
                android:id="@+id/btn_camera_permission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Grant Camera Permission"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_overlay_permission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Enable Floating Overlay"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_accessibility_permission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Enable Accessibility Service"
                android:layout_marginBottom="24dp" />

            <!-- Help Guide Card -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AIRTOUCH GESTURE CHEAT SHEET:\n\n👉 POINTER &amp; CLICK:\n• Index Finger: Aim laser reticle\n• Pinch Thumb + Index (or Dip Index): Tap / Touch\n\n✌ TWO FINGERS (SCROLL &amp; TABS):\n• Flick UP / DOWN: Next / Previous Reel (Anti-Rebound protected)\n• Push LEFT / RIGHT: Switch Tabs / Stories / Photos\n\n✋ OPEN PALM 4-WAY NAVIGATION:\n• Move Left: Back\n• Move Right: Recent Apps (Multitasking)\n• Move Top: Home Screen\n• Move Bottom: Notification Shade &amp; Quick Settings\n\n✊ CLOSED FIST:\n• Air Clutch: Freeze pointer &amp; pause tracking"
                android:textColor="#E2E8F0"
                android:textSize="12.5sp"
                android:padding="16dp"
                android:background="#1E293B"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>
    </ScrollView>

    <!-- In-App Floating Touch Puck Cursor -->
    <ImageView
        android:id="@+id/in_app_cursor"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/cursor_pointer"
        android:visibility="gone"
        android:elevation="20dp" />

</FrameLayout>
